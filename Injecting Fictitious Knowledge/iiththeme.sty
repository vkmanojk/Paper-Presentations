\ProvidesPackage{iiththeme}

% -------------------------------------------------
% Required packages
% -------------------------------------------------
\RequirePackage{graphicx}

% -------------------------------------------------
% Theme settings
% -------------------------------------------------
\usetheme{Madrid}
\useoutertheme{miniframes}
\useinnertheme{circles}

% -------------------------------------------------
% IITH color palette
% -------------------------------------------------
\definecolor{IITHorange}{RGB}{243,130,33}
\definecolor{IITHyellow}{RGB}{254,203,10}

% -------------------------------------------------
% Beamer color configuration
% -------------------------------------------------
\setbeamercolor{palette primary}{
	bg=IITHorange,
	fg=white
}
\setbeamercolor{palette secondary}{
	bg=IITHorange,
	fg=white
}
\setbeamercolor{palette tertiary}{
	bg=IITHorange,
	fg=white
}
\setbeamercolor{palette quaternary}{
	bg=IITHorange,
	fg=white
}

\setbeamercolor{structure}{
	fg=IITHorange
}
\setbeamercolor{section in toc}{
	fg=IITHorange
}

\setbeamercolor{section in head/foot}{
	bg=IITHorange,
	fg=white
}

\setbeamercolor{subsection in head/foot}{
	bg=IITHyellow,
	fg=white
}

% -------------------------------------------------
% Navigation circles
% -------------------------------------------------
% Restore the default miniframe circles.
% Do not empty these templates.
\setbeamercolor{section in head/foot}{
	bg=IITHorange,
	fg=white
}

\setbeamercolor{subsection in head/foot}{
	bg=IITHyellow,
	fg=white
}

% Preserve the default miniframes headline and circles
\useoutertheme{miniframes}
\setbeamertemplate{mini frame}[default]

\makeatletter



\makeatother

% -------------------------------------------------
% Custom title page
% Order: Title -> Logo -> Author -> Institute
% -------------------------------------------------

\setbeamertemplate{title page}{
	\begin{centering}
		
		\vbox{}
		
		\vfill
		
		% Orange title band with shadow
		\begin{beamercolorbox}[
			wd=0.935\paperwidth,
			sep=5pt,
			center,
			rounded=true,
			shadow=true
			]{title}
			\usebeamerfont{title}\inserttitle\par
		\end{beamercolorbox}
		
		\vspace{0.5cm}
		
		% Institute logo
		\includegraphics[
		height=2.5cm,
		keepaspectratio
		]{images/Logo.png}
		
		\vspace{0.3cm}
		
		% Author
		{\usebeamerfont{author}\insertauthor\par}
		
		\vspace{0.1cm}
		
		% Institute
		{\usebeamerfont{institute}\insertinstitute\par}
		
		\vfill
		
	\end{centering}
}